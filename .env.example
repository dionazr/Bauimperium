# ============================================================
# BAUIMPERIUM - Environment Configuration
# ============================================================

# === DATABASE ===
DATABASE_URL=postgresql://bauimperium:bauimperium_secret_2024@localhost:5432/bauimperium
DB_PASSWORD=bauimperium_secret_2024

# === REDIS ===
REDIS_URL=redis://localhost:6379

# === JWT ===
JWT_SECRET=bauimperium-jwt-secret-change-in-production-2024

# === STRIPE (Payment & Escrow) ===
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxx

# === AI CORE ===
AI_CORE_URL=http://localhost:5000
AI_CORE_API_KEY=ai-core-api-key
OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# === CORS ===
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://bauimperium.de

# === EMAIL (SMTP) ===
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.xxxxxxxxxxxxx
