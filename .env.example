# === STORAGE (S3-compatible) ===
S3_ENDPOINT=https://fra1.digitaloceanspaces.com
S3_ACCESS_KEY=xxxxxxxxxxxxx
S3_SECRET_KEY=xxxxxxxxxxxxx
S3_BUCKET=bauimperium-uploads

# === SERVER ===
PORT=4000
NODE_ENV=development
